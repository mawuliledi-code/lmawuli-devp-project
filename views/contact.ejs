<!DOCTYPE html>
<html lang="en">
<%- include('./includes/head', { title: "Contact | StackLab", stylesheet: "index.css" }) %>

<body>
  <nav>
    <a href="/">
      <img src="/images/stacklab-logo.png" alt="StackLab Logo" />
    </a>
    <a href="/">SHOP</a>
    <a href="/burgers/new">CREATE YOUR BURGER</a>
    <a href="/contact" class="nav-active">CONTACT</a>
  </nav>

  <section class="hero">
    <h2>Get In Touch 📬</h2>
    <p>Come visit, call, or message us — we are always happy to hear from you!</p>
  </section>

  <main class="contact-section">
    <div class="contact-grid">

      <section class="contact-details">
        <h2 class="section-title">Our Details</h2>

        <div class="contact-card">
          <span class="contact-icon">📍</span>
          <div>
            <h4>Location</h4>
            <p>44 Peace Street, Code City</p>
            <p>Neukolln, Berlin</p>
          </div>
        </div>

        <div class="contact-card">
          <span class="contact-icon">📞</span>
          <div>
            <h4>Phone</h4>
            <p>+49 436 7678 986</p>
            <p>Mon -- Fri, 9am -- 9pm</p>
          </div>
        </div>

        <div class="contact-card">
          <span class="contact-icon">✉️</span>
          <div>
            <h4>Email</h4>
            <p>iamheretostay@stacklab.com</p>
            <p>We reply within 2 hours</p>
          </div>
        </div>

        <div class="contact-card">
          <span class="contact-icon">🕐</span>
          <div>
            <h4>Opening Hours</h4>
            <p>Mon -- Fri: 9am -- 10pm</p>
            <p>Sat -- Sun: 10am -- 9pm</p>
          </div>
        </div>
      </section>

      <section class="contact-form-box">
        <h2 class="section-title">Send a Message</h2>

        <form action="/contact" method="POST">
          <div class="input-group">
            <label for="name">Your Name</label>
            <input
              type="text"
              id="name"
              name="name"
              placeholder="e.g. Holified"
              required
            />
          </div>

          <div class="input-group">
            <label for="email">Email Address</label>
            <input
              type="email"
              id="email"
              name="email"
              placeholder="e.g. stacklab@gmail.com"
              required
            />
          </div>

          <div class="input-group">
            <label for="subject">Subject</label>
            <input
              type="text"
              id="subject"
              name="subject"
              placeholder="e.g. Burger Order Inquiry"
              required
            />
          </div>

          <div class="input-group">
            <label for="message">Message</label>
            <textarea
              id="message"
              name="message"
              rows="6"
              placeholder="Write your message here..."
              required
            ></textarea>
          </div>

          <div class="form-actions">
            <button type="submit">Send Message 📬</button>
          </div>
        </form>
      </section>

    </div>
  </main>

  <footer class="site-footer">
    <p>Made with Love ❤️ by <strong>StackLab</strong> &copy; <%= new Date().getFullYear() %></p>
  </footer>
</body>
</html>
