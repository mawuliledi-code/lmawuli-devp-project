<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../includes/head', { title: burger.name + ' | StackLab' }) %>
  <link rel="stylesheet" href="/styles/show.css">
</head>

<body>


  <nav class="main-nav">
    <a href="/">SHOP</a>
    <a href="/burgers/new">BUILD BURGER</a>
    <a href="/contact">CONTACT</a>
    <img
      src="/images/stacklab-logo.png"
      alt="StackLab Logo"
      style="width:100px; height:80px; object-fit:contain; margin-left:auto;"
    />
  </nav>


  <section class="hero-banner">
    <h1><%= burger.name %> 🍔</h1>
    <p>Here's your StackLab burger details.</p>
  </section>

  
  <main class="main-content">
    <div class="show-card">

      <h2 class="card-title">🍔 Burger Details</h2>

      
      <div class="show-row">
        <span class="show-label">🍔 Name</span>
        <span class="show-value"><%= burger.name %></span>
      </div>

      
      <div class="show-row">
        <span class="show-label">📋 Description</span>
        <span class="show-value"><%= burger.design || 'No description.' %></span>
      </div>

     
      <div class="show-row">
        <span class="show-label">🔗 Slug</span>
        <span class="show-value">
          <span class="slug-tag"><%= burger.slug %></span>
        </span>
      </div>

      <div class="show-row">
        <span class="show-label">💰 Price</span>
        <span class="show-value price-tag">
          $<%= (burger.priceInCents / 100).toFixed(2) %>
        </span>
      </div>

     
      <div class="show-row">
        <span class="show-label"> Date</span>
        <span class="show-value date-tag">
          <%= new Date(burger.date).toLocaleDateString('en-US', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
          }) %>
        </span>
      </div>

      
      <div class="show-actions">
        <a href="/" class="btn btn-back">← Back to Home</a>
        <a href="/burgers/<%= burger.slug %>/edit" class="btn btn-edit">✏️ Edit</a>
        <a href="/burgers/<%= burger.slug %>/delete" class="btn btn-delete">🗑️ Delete</a>
      </div>

    </div>
  </main>

 
  <footer class="site-footer">
    <p>Made with Love ❤️ by <strong>StackLab</strong> &copy; <%= new Date().getFullYear() %></p>
  </footer>

</body>
</html>
